# Copy to .env and adjust. Never commit real values.
# The backend reads the process environment; see setup.md.

# development | production
GREENOPS_ENV=development

# Address the API binds to when run directly
GREENOPS_API_HOST=127.0.0.1
GREENOPS_API_PORT=8000

# Comma-separated list of origins allowed to call the API (the frontend dev server)
GREENOPS_CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection URL. Supplied by the project owner once the database exists
# (tasks PLT-04 and CLD-03). Leave empty while running the skeleton without the database.
GREENOPS_DATABASE_URL=

# Used only by docker-compose.yml for the local database container.
# POSTGRES_PASSWORD has no default: choose your own local-only value.
POSTGRES_USER=greenops
POSTGRES_DB=greenops
POSTGRES_PASSWORD=
